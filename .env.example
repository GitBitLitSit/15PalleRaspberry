# --- QR scanner (scanner.py) ---
API_URL=https://YOUR_API_HOST/check-in
API_KEY=your_raspberry_pi_api_key

# --- Fullscreen check-in display (kiosk-display.sh) ---
# Must match KIOSK_ACCESS_SECRET on the Next.js host (Amplify / Vercel env).
# After the first load, the site sets an HttpOnly cookie; you can switch this
# to https://15palle.com/kiosk (no token) if the browser profile keeps cookies.
KIOSK_URL=https://15palle.com/kiosk?token=REPLACE_WITH_KIOSK_ACCESS_SECRET
